{
  "name": "Omega",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "cd omega && pip install --upgrade pip uv && uv sync --frozen",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/omega/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
